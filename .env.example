# Canonical public URL for SEO and social sharing (set this in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Firebase Admin SDK (server only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Private EPUB source path in Firebase Storage. The local private/epub copy is
# used during development; production falls back to this protected object.
EPUB_MASTER_STORAGE_PATH=

# Firebase web application (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Firebase App Check with reCAPTCHA Enterprise
NEXT_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_KEY=
FIREBASE_APP_CHECK_ENFORCED=false

# Paystack (server only; begin with test keys)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Transactional order email through Gmail SMTP (server only)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ORDER_EMAIL_FROM_NAME=
